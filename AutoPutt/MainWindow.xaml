<Window x:Class="AutoPutt.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Auto Putt Calculator"
        Height="770" Width="600"
        MinHeight="450" MinWidth="550"
        WindowStartupLocation="CenterScreen"
        Background="#F3F6FA">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Auto Putt Calculator"
                   FontSize="29" FontWeight="Bold" Foreground="#173451"
                   Margin="0,0,0,22" />

            <Border Grid.Row="1" Background="White" CornerRadius="10"
                Padding="18" Margin="0,0,0,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Skill Level"
                           FontWeight="SemiBold" Foreground="#30465C" Margin="0,0,0,7" />
                    <TextBlock Grid.Row="0" Grid.Column="2" Text="Putt Distance (Feet)"
                           FontWeight="SemiBold" Foreground="#30465C" Margin="0,0,0,7" />

                    <ComboBox x:Name="SkillLevelComboBox" Grid.Row="1" Grid.Column="0"
                          Height="36" SelectedIndex="3" VerticalContentAlignment="Center">
                        <ComboBoxItem Content="Tour Pro" />
                        <ComboBoxItem Content="Scratch Golfer" />
                        <ComboBoxItem Content="Five Handicap" />
                        <ComboBoxItem Content="Ten Handicap" />
                        <ComboBoxItem Content="Fifteen Handicap" />
                        <ComboBoxItem Content="Twenty Handicap" />
                    </ComboBox>

                    <TextBox x:Name="PuttDistanceTextBox" Grid.Row="1" Grid.Column="2"
                         Height="36" FontSize="16" VerticalContentAlignment="Center"
                         Text="10" MaxLength="5" />

                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
                        Content="Auto Putt" Height="42" Margin="0,20,0,0"
                        FontSize="16" FontWeight="SemiBold"
                        Background="#176B58" Foreground="White"
                        Click="AutoPuttButton_Click" IsDefault="True" />
                </Grid>
            </Border>

            <Border Grid.Row="2" Background="White" CornerRadius="10"
                Padding="18" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Selected Skill Level Result" FontSize="17"
                           FontWeight="Bold" Foreground="#173451" Margin="0,0,0,10" />
                    <TextBlock x:Name="SelectedSkillTextBlock" Text="Ten Handicap"
                           Foreground="#54677B" FontSize="14" />
                    <TextBlock x:Name="SelectedResultTextBlock" Text="Click Auto Putt to calculate"
                           FontSize="23" FontWeight="Bold" Foreground="#176B58"
                           Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3" Background="White" CornerRadius="10" Padding="18">
                <StackPanel>
                    <TextBlock Text="All Skill Levels" FontSize="17" FontWeight="Bold"
                           Foreground="#173451" Margin="0,0,0,14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="35" />
                            <RowDefinition Height="35" />
                            <RowDefinition Height="35" />
                            <RowDefinition Height="35" />
                            <RowDefinition Height="35" />
                            <RowDefinition Height="35" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Tour Pro" />
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Scratch Golfer" />
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Five Handicap" />
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Ten Handicap" />
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Fifteen Handicap" />
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Twenty Handicap" />

                        <TextBlock x:Name="TourProResultTextBlock" Grid.Row="0" Grid.Column="1"
                               Text="—" FontWeight="SemiBold" />
                        <TextBlock x:Name="ScratchResultTextBlock" Grid.Row="1" Grid.Column="1"
                               Text="—" FontWeight="SemiBold" />
                        <TextBlock x:Name="FiveHandicapResultTextBlock" Grid.Row="2" Grid.Column="1"
                               Text="—" FontWeight="SemiBold" />
                        <TextBlock x:Name="TenHandicapResultTextBlock" Grid.Row="3" Grid.Column="1"
                               Text="—" FontWeight="SemiBold" />
                        <TextBlock x:Name="FifteenHandicapResultTextBlock" Grid.Row="4" Grid.Column="1"
                               Text="—" FontWeight="SemiBold" />
                        <TextBlock x:Name="TwentyHandicapResultTextBlock" Grid.Row="5" Grid.Column="1"
                               Text="—" FontWeight="SemiBold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </ScrollViewer>
</Window>
